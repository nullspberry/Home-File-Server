# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/

# Production build artifacts
build/
dist/

# Environment files and secrets
.env
.env*.local
!.env.example

# Local databases and registered data
/data/*.json
!data/.gitkeep

# Sample movies and large media files
/movies/*
!movies/.gitkeep

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js telemetry and cache
.next/cache
*.tsbuildinfo
next-env.d.ts

# OS generated files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo

